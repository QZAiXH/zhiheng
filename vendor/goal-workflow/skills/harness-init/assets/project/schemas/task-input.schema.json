{
  "$defs": {
    "binding": {
      "additionalProperties": true,
      "properties": {
        "C": {
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "C_kind": {
          "enum": [
            "commit",
            "tree"
          ]
        },
        "H": {
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "T": {
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "checks_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "environment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "spec_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "task_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "H",
        "T",
        "C",
        "C_kind",
        "spec_sha256",
        "checks_sha256",
        "environment_sha256",
        "task_sha256"
      ],
      "type": "object"
    },
    "report": {
      "additionalProperties": true,
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$id": "urn:goal-workflow:task-input:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "attempt_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "checkpoint_revision": {
      "minimum": 0,
      "type": "integer"
    },
    "mode": {
      "enum": [
        "local",
        "github"
      ]
    },
    "repository_id": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "required_acceptance_ids": {
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
        "type": "string"
      },
      "maxItems": 500,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "required_check_ids": {
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "run_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "mode",
    "repository_id",
    "task_id",
    "run_id",
    "attempt_id",
    "checkpoint_revision",
    "binding",
    "required_acceptance_ids",
    "required_check_ids"
  ],
  "title": "Task input snapshot v1",
  "type": "object"
}
